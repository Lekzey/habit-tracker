{
  "manifest_version": 3,
  "name": "HabitTracker",
  "version": "1.0.0",
  "description": "Local-only time tracker: see how long you spend on each site, active vs. background, in charts. All data stays on your device — nothing is ever sent anywhere.",
  "permissions": ["tabs", "storage", "unlimitedStorage", "idle", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "HabitTracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  }
}
